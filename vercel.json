{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/bg/kosik", "destination": "/checkout", "permanent": false },
    { "source": "/bg/kosik.html", "destination": "/checkout", "permanent": false },
    { "source": "/kosik", "destination": "/checkout", "permanent": false },
    { "source": "/kosik.html", "destination": "/checkout", "permanent": false },
    { "source": "/produkty", "destination": "/bg/produkty", "permanent": false },
    { "source": "/produkty/", "destination": "/bg/produkty", "permanent": false },
    { "source": "/bg/prihlaseni", "destination": "/account/login", "permanent": false },
    { "source": "/bg/prihlaseni.html", "destination": "/account/login", "permanent": false },
    { "source": "/bg/registrace", "destination": "/account/register", "permanent": false },
    { "source": "/bg/registrace.html", "destination": "/account/register", "permanent": false },
    { "source": "/bg.html", "destination": "/", "permanent": true },
    { "source": "/:path*.html", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin-page" },
    { "source": "/admin/", "destination": "/api/admin-page" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/checkout/", "destination": "/checkout/index.html" },
    { "source": "/account/login", "destination": "/account/login.html" },
    { "source": "/account/register", "destination": "/account/register.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/404", "destination": "/404.html" },
    { "source": "/bg", "destination": "/index.html" },
    { "source": "/bg/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/storage/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
