{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/bg/kosik", "destination": "/checkout", "permanent": false },
    { "source": "/bg/kosik.html", "destination": "/checkout", "permanent": false },
    { "source": "/kosik", "destination": "/checkout", "permanent": false },
    { "source": "/kosik.html", "destination": "/checkout", "permanent": false },
    { "source": "/bg/produkty", "destination": "/produkty", "permanent": false },
    { "source": "/bg/produkty.html", "destination": "/produkty", "permanent": false },
    { "source": "/bg.html", "destination": "/", "permanent": true },
    { "source": "/:path*.html", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/checkout", "destination": "/checkout/index.html" },
    { "source": "/checkout/", "destination": "/checkout/index.html" },
    { "source": "/produkty", "destination": "/produkty/index.html" },
    { "source": "/produkty/", "destination": "/produkty/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/bg", "destination": "/index.html" },
    { "source": "/bg/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/storage/catalog.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
